NODE_ENV=development
PORT=9005

MONGO_URI=mongodb://127.0.0.1:27017/isosmack

# Change these before going anywhere near production.
# Generate with: openssl rand -hex 32
# Must be at least 32 characters and unique per service. The service refuses to
# start on a missing, short, or placeholder value, so this line has to be replaced.
JWT_SECRET=REPLACE_ME
# Generate with: openssl rand -hex 32
# Must be at least 32 characters and unique per service. The service refuses to
# start on a missing, short, or placeholder value, so this line has to be replaced.
JWT_REFRESH_SECRET=REPLACE_ME
ACCESS_TTL=30m
REFRESH_TTL_DAYS=30

CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
COOKIE_SECURE=false

# ---- Cloudinary ----
# Leave blank to store uploads on local disk (./uploads). Fill in to go live.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=isosmack

# ---- Razorpay ----
# Leave blank to run the simulated gateway (checkout works, no money moves).
# Add your test keys from https://dashboard.razorpay.com/app/keys to go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Store rules (also editable from the admin panel) ----
CURRENCY=INR
FREE_SHIPPING_ABOVE=999
SHIPPING_FEE=69
PREPAID_BONUS_PCT=3
COD_ENABLED=true
COD_FEE=49
COD_MAX_ORDER=5000

# ---- Seed defaults ----
SEED_ADMIN_EMAIL=admin@isosmack.com
SEED_ADMIN_PASSWORD=Admin@12345
