# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/etrade

# Auth
# Generate with: openssl rand -hex 32
# Must be at least 32 characters and unique per service. The service refuses to
# start on a missing, short, or placeholder value, so this line has to be replaced.
JWT_SECRET=REPLACE_ME
JWT_EXPIRES_IN=30d

# Razorpay (get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Cloudinary (optional - for cloud image uploads; if not set, uses local /uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (optional - for order confirmations)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ezoneshoppi <noreply@ezoneshoppi.com>

# Seed admin
ADMIN_EMAIL=admin@etrade.com
ADMIN_PASSWORD=Admin@12345
