PORT=5000
MONGODB_URI=mongodb://localhost:27017/crunz
# Generate with: openssl rand -hex 32
# Must be at least 32 characters and unique per service. The service refuses to
# start on a missing, short, or placeholder value, so this line has to be replaced.
JWT_SECRET=REPLACE_ME
CLIENT_URL=http://localhost:3000

# Google OAuth — from console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# SMTP (Gmail App Password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
ADMIN_EMAIL=admin@crunzofficial.com

# Stripe — from dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudinary — from cloudinary.com/console
# Required: banner + product images uploaded from the admin panel go here.
# If these are missing the server falls back to storing images on local disk.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
