# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/aligaah

# ---- Auth ----
# Generate with: openssl rand -hex 32
# Must be at least 32 characters and unique per service. The service refuses to
# start on a missing, short, or placeholder value, so this line has to be replaced.
JWT_SECRET=REPLACE_ME
JWT_EXPIRE=30d

# ---- Default admin (created on seed) ----
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@aligaah.com
ADMIN_PASSWORD=admin12345

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- Email (SMTP) ----
# Gmail: use an App Password (Google Account > Security > 2-Step > App passwords),
# not the account password. MAIL_FROM must be the authenticated address or a
# verified alias, otherwise SPF/DKIM fail and mail goes to spam.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM=Aligaah Designs <you@gmail.com>

# ---- Order notifications ----
# Where the "new order" alert goes. Comma-separate for more than one recipient.
OWNER_EMAIL=owner@example.com

# ---- Razorpay ----
# Dashboard > Account & Settings > API Keys
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
# Dashboard > Settings > Webhooks -> POST /api/orders/razorpay/webhook
# (events: payment.captured, payment.failed). Leave blank to disable webhooks.
RAZORPAY_WEBHOOK_SECRET=
